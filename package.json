{
  "name": "cool-lin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:widget-demo": "npm --prefix apps/coolmessenger-widget-demo run dev",
    "build": "npm --prefix packages/schedule-engine run build && npm --prefix server run build && npm --prefix client run build",
    "install:all": "npm --prefix client install && npm --prefix server install && npm --prefix packages/schedule-engine install && npm --prefix apps/coolmessenger-widget-demo install",
    "engine:analyze": "npm --prefix packages/schedule-engine run analyze",
    "engine:extract": "npm --prefix packages/schedule-engine run extract",
    "engine:eval": "npm --prefix packages/schedule-engine run eval",
    "engine:test": "npm --prefix packages/schedule-engine test",
    "engine:trace": "npm --prefix packages/schedule-engine run trace",
    "engine:audit": "npm --prefix packages/schedule-engine run audit",
    "engine:sample": "npm --prefix packages/schedule-engine run sample"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
