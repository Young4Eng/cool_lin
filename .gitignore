node_modules/
dist/
.env
.env.local
*.log
.DS_Store
__pycache__/
*.pyc

# 실제 쿨메신저 내보내기 원본은 커밋하지 않는다 (PRD 22장)
coolexcel/
*.xls
*.xlsx
!fixtures/**/*.xls
새 폴더/
# 실제 데이터로 만든 추출 결과 (실명 포함 가능)
candidates.json
*.candidates.json

# 목업 메신저 레퍼런스 바이너리 (3MB PE) — 추출 소스만 커밋한다
#   docs/reference/coolmessenger-gentoo/ 참조
CoolMessenger.exe

# Windows 에서 `--json=/dev/null` 같은 명령이 만들어 버리는 파일.
# 추출 결과(실명 포함 가능)가 그대로 들어간다.
nul

# CoolMessenger.exe 를 저장소 폴더에서 실행하면 만들어지는 창 상태 파일
.tmp/

# Tauri 빌드 산출물 (Rust target 은 수 GB 가 된다)
src-tauri/target/
apps/coolmessenger-widget-demo/src-tauri/target/
# Tauri 가 빌드할 때 다시 만드는 스키마
apps/coolmessenger-widget-demo/src-tauri/gen/

# 로컬 PII 키·암호문 (실제 위치는 %LOCALAPPDATA%\cool_lin)
pii.key
pii-map.json

# 나눠 주려고 저장소 맨 위에 복사해 둔 위젯 설치파일 (원본은 target/release/bundle/nsis)
쿨린위젯_설치.exe
