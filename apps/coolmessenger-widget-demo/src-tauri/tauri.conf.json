{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoolLin Widget",
  "version": "0.1.0",
  "identifier": "kr.coollin.schedule.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "쿨린 일정 위젯",
        "url": "widget.html",
        "width": 380,
        "height": 660,
        "minWidth": 320,
        "minHeight": 460,
        "resizable": true,
        "alwaysOnTop": true,
        "center": false
      },
      {
        "label": "calendar",
        "title": "쿨린 캘린더 - 크게 보기",
        "url": "calendar.html",
        "width": 980,
        "height": 720,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "쿨메신저 쪽지에서 뽑은 일정을 바탕화면 위젯으로 보여 주는 데모",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../../../server/python": "python"
    }
  }
}
